import { useState } from "react";

// ==========================================
// Sign In / Sign Up Component
// ==========================================
function SignInSignUp({ setActiveTab }) {
  return (
    <div className="w-full min-w-0 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 className="text-2xl font-semibold text-slate-900">Welcome Back</h2>
      <p className="mt-3 text-sm text-slate-500">
        Please sign in or create a new account to continue.
      </p>

      <div className="mt-6 flex gap-4">
        <button
          onClick={() => setActiveTab("SignIn")}
          className="rounded-xl bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-700"
        >
          Sign In
        </button>
        <button
          onClick={() => setActiveTab("SignUp")}
          className="rounded-xl bg-slate-600 px-4 py-2 text-white hover:bg-slate-700"
        >
          Sign Up
        </button>
      </div>
    </div>
  );
}

// ==========================================
// Render Active Page
// ==========================================
function renderPage(tab, setActiveTab) {
  switch (tab) {
    case "Logout":
      return (
        <div className="w-full min-w-0 space-y-6">
          {/* Logout Confirmation */}
          <div className="w-full min-w-0 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 className="text-2xl font-semibold text-slate-900">Logged out</h2>
            <p className="mt-3 text-sm text-slate-500">
              You have successfully signed out.
            </p>

            {/* Redirect to Sign In / Sign Up */}
            <div className="mt-6">
              <SignInSignUp setActiveTab={setActiveTab} />
            </div>
          </div>
        </div>
      );

    case "SignIn":
      return (
        <div className="w-full min-w-0 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="text-2xl font-semibold text-slate-900">Sign In</h2>
          <p className="mt-3 text-sm text-slate-500">Enter your credentials.</p>
          <form className="mt-6 space-y-4">
            <input
              type="email"
              placeholder="Email"
              className="w-full rounded-xl border px-4 py-2"
            />
            <input
              type="password"
              placeholder="Password"
              className="w-full rounded-xl border px-4 py-2"
            />
            <button className="w-full rounded-xl bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-700">
              Sign In
            </button>
          </form>
        </div>
      );

    case "SignUp":
      return (
        <div className="w-full min-w-0 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="text-2xl font-semibold text-slate-900">Sign Up</h2>
          <p className="mt-3 text-sm text-slate-500">
            Create a new account to get started.
          </p>
          <form className="mt-6 space-y-4">
            <input
              type="text"
              placeholder="Name"
              className="w-full rounded-xl border px-4 py-2"
            />
            <input
              type="email"
              placeholder="Email"
              className="w-full rounded-xl border px-4 py-2"
            />
            <input
              type="password"
              placeholder="Password"
              className="w-full rounded-xl border px-4 py-2"
            />
            <button className="w-full rounded-xl bg-slate-600 px-4 py-2 text-white hover:bg-slate-700">
              Sign Up
            </button>
          </form>
        </div>
      );

    default:
      return (
        <div className="w-full min-w-0">
          <p>Select a page</p>
        </div>
      );
  }
}

// ==========================================
// App Component
// ==========================================
export default function App() {
  const [activeTab, setActiveTab] = useState("Logout");

  return (
    <div className="flex min-h-screen w-full min-w-0 overflow-x-hidden bg-slate-50">
      <main className="flex-1 p-6">
        {renderPage(activeTab, setActiveTab)}
      </main>
    </div>
  );
}
